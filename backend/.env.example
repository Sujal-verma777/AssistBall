# AssistBall backend configuration
APP_API_KEY=change-this-local-api-key
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_PER_MIN=20

# Options: claude | openai | gemini | mock
PROVIDER=mock

# Optional provider model override
# Claude: claude-sonnet-5-5
# OpenAI: gpt-4o
# Gemini: gemini-2.5-flash
MODEL_NAME=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
